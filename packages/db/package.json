{
  "name": "@aps/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "studio": "drizzle-kit studio",
    "seed": "node --experimental-strip-types src/seed/index.ts",
    "seed:extra": "node --experimental-strip-types src/seed/add-extra.ts"
  },
  "dependencies": {
    "@aps/shared": "*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "@electric-sql/pglite": "^0.5.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3"
  }
}
