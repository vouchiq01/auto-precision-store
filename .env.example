# ─── Database ────────────────────────────────────────────────────────────────
# Local development with no Postgres server or Supabase project:
DATABASE_URL=pglite://./.localdb
#
# Supabase (production). Use the POOLED connection string (port 6543) here:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# …and the DIRECT one (port 5432) for migrations, which need an advisory lock:
# DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

# ─── SMS / OTP ───────────────────────────────────────────────────────────────
# "mock" prints the code to the server log and also accepts 123456.
# The server refuses to boot in production with SMS_PROVIDER=mock.
SMS_PROVIDER=mock
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=       # must be a DLT-approved template containing ##OTP##
# MSG91_SENDER_ID=         # your 6-character registered sender id

# Only for a staging deploy that is reachable over the internet before MSG91 is
# ready. With this on, every OTP really is 123456 — anyone who knows that can
# sign in as any phone number. Never set this on a deployment real customers
# can reach, and turn it back off the moment MSG91 is configured.
# ALLOW_MOCK_SMS_IN_PRODUCTION=true

# ─── Payments ────────────────────────────────────────────────────────────────
# Optional locally; REQUIRED in production or the API will not start.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=   # set this in the Razorpay dashboard webhook config

# ─── WhatsApp order notifications ──────────────────────────────────────────────
# "mock" prints the message to the server log. New order -> seller;
# status change -> buyer. Never blocks checkout or an admin status change —
# a failure here is logged and swallowed, not surfaced to either of them.
WHATSAPP_PROVIDER=mock
# META_WHATSAPP_PHONE_NUMBER_ID=       # from Meta Business Manager
# META_WHATSAPP_ACCESS_TOKEN=          # a PERMANENT (system user) token — a
#                                       # short-lived one expires and every
#                                       # notification silently stops sending
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=   # optional; only needed to manage templates via this app
# META_WHATSAPP_API_VERSION=v21.0
# SELLER_WHATSAPP_NUMBER=+91XXXXXXXXXX # where "new order" alerts go
# WHATSAPP_TEMPLATE_ORDER_PLACED=      # an APPROVED template name, seller-facing
# WHATSAPP_TEMPLATE_ORDER_PLACED_LANG=en
# WHATSAPP_TEMPLATE_ORDER_STATUS=      # an APPROVED template name, buyer-facing
# WHATSAPP_TEMPLATE_ORDER_STATUS_LANG=en

# ─── Storage (admin image uploads) ───────────────────────────────────────────
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # server-only; never expose this to the browser
# SUPABASE_STORAGE_BUCKET=media

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# COOKIE_DOMAIN=.autoprecision.store   # only when API and web share a domain

# ─── Seed ────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@autoprecision.store
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ─── Frontend (apps/web) ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
